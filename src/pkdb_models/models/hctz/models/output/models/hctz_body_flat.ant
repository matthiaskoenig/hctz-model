  Cout_ki_hctz := KI__Cpl_hctz;
  KI__Cu_is_hctz := (fu_hctz/KI__K_int_pls_hctz)*KI__Cis_hctz;
  KI__Cu_ic_hctz := (fu_hctz/KI__K_cell_pls_hctz)*KI__Cic_hctz;
  Rurine_hctz := KI__J_gfr_hctz + KI__HCTZSEC;
  Cout_st_hctz := ST__Cpl_hctz;
  ST__Cu_ti_hctz := (fu_hctz/Kp_hctz)*ST__Cti_hctz;
  Cout_si_hctz := GU__Cpl_hctz;
  GU__Cu_ti_hctz := (fu_hctz/Kp_hctz)*GU__Cti_hctz;
