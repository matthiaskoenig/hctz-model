  substanceOnly species FLUID__na_urine in FLUID__Vurine, FLUID__cl_urine in FLUID__Vurine;

  // Assignment Rules:
  FLUID__ECF_ref := FLUID__f_ECF*FLUID__f_TBW*BW;
  FLUID__H2O_UPTAKE := FLUID__vin_h2o*FLUID__ECF_ref^FLUID__counter_gamma/FLUID__ECF^FLUID__counter_gamma;
  FLUID__GFR := GFR*1000 FLUID__ml_per_l;
  FLUID__h2o_reabsorption := FLUID__GFR*0.001 FLUID__l_per_ml - FLUID__diuresis;
  FLUID__diuresis := min((FLUID__k_h2o*FLUID__GFR*FLUID__ECF^FLUID__counter_gamma/FLUID__ECF_ref^FLUID__counter_gamma)*FLUID__NA_EXCRETION/FLUID__vin_na, FLUID__f_h2o_max*FLUID__GFR*0.001 FLUID__l_per_ml);
  Kiv_hctz := (ln(2)/ti_hctz)*60 s_per_min;
  Car_free_hctz := fu_hctz*Car_hctz;
  Car_blood_hctz := BP_hctz*Car_hctz;
  Cve_free_hctz := fu_hctz*Cve_hctz;
  Cve_blood_hctz := BP_hctz*Cve_hctz;
  Cpo_free_hctz := fu_hctz*Cpo_hctz;
  Cpo_blood_hctz := BP_hctz*Cpo_hctz;
  Chv_hctz := ((1 dimensionless - f_shunt)*Qh*Cout_li_hctz + f_shunt*(Qha*Car_hctz + Qpo*Cpo_hctz))/Qh;
  Cout_li_hctz := LI__Cpl_hctz;
  Chv_free_hctz := fu_hctz*Chv_hctz;
  Chv_blood_hctz := BP_hctz*Chv_hctz;
  Carm_hctz := w_arm_sk*Cout_sk_hctz + w_arm_mu*Cout_mu_hctz;
  Cout_sk_hctz := SK__Cpl_hctz;
  Cout_mu_hctz := MU__Cpl_hctz;
  Carm_free_hctz := fu_hctz*Carm_hctz;
  Carm_blood_hctz := BP_hctz*Carm_hctz;
  Cout_lu_hctz := LU__Cpl_hctz;
  LU__Cu_ti_hctz := (fu_hctz/Kp_hctz)*LU__Cti_hctz;
  Cout_he_hctz := HE__Cpl_hctz;
  HE__Cu_ti_hctz := (fu_hctz/Kp_hctz)*HE__Cti_hctz;
