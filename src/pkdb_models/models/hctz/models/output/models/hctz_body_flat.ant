  GU__J_abs_jej2_hctz: GU__Clumen_jej2_hctz => GU__Cpl_hctz; (ka_hctz/60 min_per_hr)*GU__f_area_jej2*GU__Vlumen_jej2*GU__Clumen_jej2_hctz;
  GU__J_tr_ile1_hctz: GU__Clumen_ile1_hctz => GU__Clumen_ile2_hctz; GU__Vlumen_ile1*GU__Clumen_ile1_hctz/(GU__T_ile1*fimp_t_si);
  GU__J_abs_ile1_hctz: GU__Clumen_ile1_hctz => GU__Cpl_hctz; (ka_hctz/60 min_per_hr)*GU__f_area_ile1*GU__Vlumen_ile1*GU__Clumen_ile1_hctz;
  GU__J_tr_ile2_hctz: GU__Clumen_ile2_hctz => GU__Clumen_cae_hctz; GU__Vlumen_ile2*GU__Clumen_ile2_hctz/(GU__T_ile2*fimp_t_si);
