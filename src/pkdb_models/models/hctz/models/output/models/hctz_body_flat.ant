  PA__Cu_ti_hctz := (fu_hctz/Kp_hctz)*PA__Cti_hctz;
  MU__Cu_ti_hctz := (fu_hctz/Kp_hctz)*MU__Cti_hctz;
  SK__Cu_ti_hctz := (fu_hctz/Kp_hctz)*SK__Cti_hctz;
