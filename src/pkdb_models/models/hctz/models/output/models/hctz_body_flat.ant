  Cout_bo_hctz := BO__Cpl_hctz;
  BO__Cu_ti_hctz := (fu_hctz/Kp_hctz)*BO__Cti_hctz;
  Cout_go_hctz := GO__Cpl_hctz;
  GO__Cu_ti_hctz := (fu_hctz/Kp_hctz)*GO__Cti_hctz;
  FLUID__GFR_base := GFR_base*1000 FLUID__ml_per_l;
  FLUID__bp_systolic := FLUID__Psys_ref*FLUID__ECF/FLUID__ECF_ref;
  FLUID__bp_diastolic := FLUID__Pdia_ref*FLUID__ECF/FLUID__ECF_ref;
  FLUID__bp_mean := (FLUID__bp_systolic + 2 dimensionless*FLUID__bp_diastolic)/3 dimensionless;
  FLUID__vin_na := FLUID__k_na*FLUID__na_ref;
  FLUID__vin_cl := FLUID__k_cl*FLUID__cl_ref;
  FLUID__vout_na := FLUID__NA_EXCRETION*FLUID__Mr_na;
  FLUID__vout_cl := FLUID__CL_EXCRETION*FLUID__Mr_cl;
  FLUID__hctz_urine_excretion := Rurine_hctz/FLUID__diuresis;

  // Rate Rules:
  FLUID__ECF' = (FLUID__H2O_UPTAKE - FLUID__vout_h2o - FLUID__GFR*0.001 FLUID__l_per_ml) + FLUID__h2o_reabsorption;
  FLUID__Vloop' = FLUID__GFR*0.001 FLUID__l_per_ml - FLUID__diuresis - FLUID__h2o_reabsorption;
  FLUID__Vurine' = FLUID__diuresis;
  IVDOSE_hctz' = -J_iv_hctz*Mr_hctz + Ri_hctz;
  PODOSE_hctz' = -(GU__J_po_hctz + GU__J_trs_st_hctz)*Mr_hctz;
  SOLDOSE_hctz' = -GU__J_sol_hctz*Mr_hctz;

  // Reactions:
  J_iv_hctz:  => Cve_hctz; Kiv_hctz*IVDOSE_hctz/Mr_hctz;
  GU__J_po_hctz:  => GU__Clumen_st_hctz; (Ka_dis_hctz/60 min_per_hr)*PODOSE_hctz/Mr_hctz;
  GU__J_trs_st_hctz:  => GU__Asolid_du_hctz; PODOSE_hctz/Mr_hctz/((GU__T_st + FED*(GU__T_st_fed - GU__T_st))*fimp_t_stomach);
  GU__J_sol_hctz:  => GU__Clumen_st_hctz; (Ka_sol_hctz/60 min_per_hr)*SOLDOSE_hctz/Mr_hctz;
  KI__J_gfr_hctz: KI__Cpl_hctz => Aurine_hctz; fu_hctz*GFR*Car_hctz*(1 dimensionless - f_reabsorbed_hctz);
  KI__HCTZSEC in KI__Vic: KI__Cic_hctz => Aurine_hctz; (KI__f_abcc4*((1 dimensionless - KI__f_tubular) + KI__f_tubular*f_renal_function)*KI__HCTZSEC_k*fu_hctz/KI__K_cell_pls_hctz)*KI__Cic_hctz;
  FLUID__NA_EXCRETION in FLUID__Vki: FLUID__na_loop => FLUID__na_urine; FLUID__k_na*FLUID__na_loop*(1 dimensionless + (FLUID__GFR/FLUID__GFR_base)*FLUID__Emax_hctz_na*max(Cout_ki_hctz, 0 mM)/(max(Cout_ki_hctz, 0 mM) + FLUID__E50_hctz_nacl));
