  GU__J_tr_st_hctz: GU__Clumen_st_hctz => GU__Clumen_du_hctz; GU__Vlumen_st*GU__Clumen_st_hctz/((GU__T_st + FED*(GU__T_st_fed - GU__T_st))*fimp_t_stomach);
  GU__J_tr_du_hctz: GU__Clumen_du_hctz => GU__Clumen_jej1_hctz; GU__Vlumen_du*GU__Clumen_du_hctz/(GU__T_du*fimp_t_si);
