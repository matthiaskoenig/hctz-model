  HE__J_out_pl_hctz: HE__Cpl_hctz => Cve_hctz; Qhe*BP_hctz*Cout_he_hctz;
  HE__J_ti_hctz: HE__Cpl_hctz -> HE__Cti_hctz; HE__PS_hctz*fu_hctz*(HE__Cpl_hctz - HE__Cti_hctz/Kp_hctz);
  BR__J_in_ar_pl_hctz: Car_hctz => BR__Cpl_hctz; Qbr*BP_hctz*Car_hctz;
  BR__J_out_pl_hctz: BR__Cpl_hctz => Cve_hctz; Qbr*BP_hctz*Cout_br_hctz;
  BR__J_ti_hctz: BR__Cpl_hctz -> BR__Cti_hctz; BR__PS_hctz*fu_hctz*(BR__Cpl_hctz - BR__Cti_hctz/Kp_hctz);
  LI__J_in_ar_pl_hctz: Car_hctz => LI__Cpl_hctz; (1 dimensionless - f_shunt)*Qha*BP_hctz*Car_hctz;
  LI__J_shunt_ar_pl_hctz: Car_hctz => Cve_hctz; f_shunt*Qha*BP_hctz*Car_hctz;
  LI__J_in_po_pl_hctz: Cpo_hctz => LI__Cpl_hctz; (1 dimensionless - f_shunt)*Qpo*BP_hctz*Cpo_hctz;
  LI__J_shunt_po_pl_hctz: Cpo_hctz => Cve_hctz; f_shunt*Qpo*BP_hctz*Cpo_hctz;
  LI__J_out_pl_hctz: LI__Cpl_hctz => Cve_hctz; (1 dimensionless - f_shunt)*Qh*BP_hctz*Cout_li_hctz;
  LI__J_ti_hctz: LI__Cpl_hctz -> LI__Cti_hctz; LI__PS_hctz*fu_hctz*(LI__Cpl_hctz - LI__Cti_hctz/Kp_hctz);
  KI__J_in_ar_pl_hctz: Car_hctz => KI__Cpl_hctz; Qki*BP_hctz*Car_hctz;
  KI__J_out_pl_hctz: KI__Cpl_hctz => Cve_hctz; Qki*BP_hctz*Cout_ki_hctz - fu_hctz*GFR*Cout_ki_hctz*(1 dimensionless - f_reabsorbed_hctz);
  KI__J_is_hctz: KI__Cpl_hctz -> KI__Cis_hctz; KI__PS_vas*fu_hctz*(KI__Cpl_hctz - KI__Cis_hctz/KI__K_int_pls_hctz);
  KI__J_ic_hctz: KI__Cis_hctz -> KI__Cic_hctz; KI__PS_hctz*((fu_hctz/KI__K_int_pls_hctz)*KI__Cis_hctz - (fu_hctz/KI__K_cell_pls_hctz)*KI__Cic_hctz);
  KI__HCTZUP in KI__Vic: KI__Cis_hctz => KI__Cic_hctz; (KI__f_slc22a6*fimp_ki_slc22a6*((1 dimensionless - KI__f_tubular) + KI__f_tubular*f_renal_function)*KI__HCTZUP_k*Vki*fu_hctz/KI__K_int_pls_hctz)*KI__Cis_hctz;
  ST__J_in_ar_pl_hctz: Car_hctz => ST__Cpl_hctz; Qst*BP_hctz*Car_hctz;
  ST__J_out_pl_hctz: ST__Cpl_hctz => Cpo_hctz; Qst*BP_hctz*Cout_st_hctz;
  ST__J_ti_hctz: ST__Cpl_hctz -> ST__Cti_hctz; ST__PS_hctz*fu_hctz*(ST__Cpl_hctz - ST__Cti_hctz/Kp_hctz);
