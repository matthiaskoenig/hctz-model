  GU__J_tr_cae_hctz: GU__Clumen_cae_hctz => GU__Clumen_asc_hctz; GU__Vlumen_cae*GU__Clumen_cae_hctz/GU__T_cae;
  GU__J_abs_cae_hctz: GU__Clumen_cae_hctz => GU__Cpl_hctz; (ka_hctz/60 min_per_hr)*GU__f_area_cae*GU__Vlumen_cae*GU__Clumen_cae_hctz;
